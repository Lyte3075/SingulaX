// 06_todo_app.sglx //
// TOPIC: A complete interactive command-line application. //
// This one script contains its data, functions, validation, commands, and main loop. //
// Commands: add, list, done, remove, clear, help, quit. //

let tasks = []

// Add validates the title before storing a task. //
function add_task(title)
  if title.trim() == "" then
    say("Task title cannot be empty.")
    return nothing
  end

  tasks.push({
    title: title.trim(),
    complete: false
  })

  say("Added:", title.trim())
end

// List prints every task and its completion state. //
function show_tasks()
  if len(tasks) == 0 then
    say("No tasks yet.")
    return nothing
  end

  let index = 0
  for each task in tasks do
    let mark = "[ ]"
    if task.complete then
      mark = "[x]"
    end
    say(index, mark, task.title)
    index = index + 1
  end
end

// Done validates an index before changing the task. //
function complete_task(index)
  if index < 0 or index >= len(tasks) then
    say("That task does not exist.")
    return nothing
  end

  tasks[index].complete = true
  say("Completed:", tasks[index].title)
end

// Remove deletes a task only when its index is valid. //
function remove_task(index)
  if index < 0 or index >= len(tasks) then
    say("That task does not exist.")
    return nothing
  end

  let removed = tasks[index].title
  tasks.pop(index)
  say("Removed:", removed)
end

// Clear removes completed tasks and keeps unfinished tasks. //
function clear_completed()
  let remaining = []
  for each task in tasks do
    if not task.complete then
      remaining.push(task)
    end
  end
  tasks = remaining
  say("Completed tasks cleared.")
end

// Help documents every command directly inside the program. //
function show_help()
  say("Commands:")
  say("add    - create a task")
  say("list   - show tasks")
  say("done   - complete a task")
  say("remove - delete a task")
  say("clear  - remove completed tasks")
  say("help   - show this help")
  say("quit   - exit")
end

say("=== SingulaX To-Do App ===")
show_help()

// The command loop keeps the application alive until quit is entered. //
let running = true
while running do
  let command = ask("> ").trim().lower()

  if command == "add" then
    add_task(ask("Task title: "))
  elseif command == "list" then
    show_tasks()
  elseif command == "done" then
    complete_task(to_number(ask("Task number: ")))
  elseif command == "remove" then
    remove_task(to_number(ask("Task number: ")))
  elseif command == "clear" then
    clear_completed()
  elseif command == "help" then
    show_help()
  elseif command == "quit" then
    running = false
  else
    say("Unknown command. Type help for commands.")
  end
end

say("Goodbye!")
