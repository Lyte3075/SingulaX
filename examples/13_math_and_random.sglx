// 13_math_and_random.sglx //
// TOPIC: Numbers, math functions, ranges, and random values. //

say("=== Math and Random ===")

let radius = 5
let height = 12

say("Absolute value:", abs(-42))
say("Minimum:", min(8, 3, 11))
say("Maximum:", max(8, 3, 11))
say("Square root:", sqrt(144))
say("Power:", radius ^ 2)
say("Circle area:", 3.14159 * radius ^ 2)

// random creates a value you can use for games and simulations. //
let roll = random(1, 6)
say("Dice roll:", roll)

let choices = ["red", "green", "blue", "yellow"]
say("Random choice:", random_choice(choices))

// A range is useful for repeated numeric work. //
let values = range(1, 6)
say("Range:", values)

let total = 0
for each value in values do
  total += value
end
say("Range total:", total)
