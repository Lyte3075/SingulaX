// 03_blueprints.sglx //
// TOPIC: Blueprints, initialization, methods, objects, and inheritance. //
// A blueprint is SingulaX's reusable object definition. //

say("=== SingulaX Blueprints ===")

// Animal defines shared object data and behavior. //
blueprint Animal
  function init(self, name, sound)
    self.name = name
    self.sound = sound
  end

  function speak(self)
    return self.name + " says " + self.sound
  end
end

// Dog inherits Animal and adds its own data and methods. //
blueprint Dog is Animal
  function init(self, name)
    self.name = name
    self.sound = "Woof"
    self.tricks = []
  end

  function learn_trick(self, trick)
    self.tricks.push(trick)
  end

  function show_off(self)
    say(self.speak())
    say(self.name, "knows:", self.tricks)
  end
end

// new creates an object and calls its init method. //
let animal = new Animal("Creature", "...")
say(animal.speak())

let rex = new Dog("Rex")
rex.learn_trick("sit")
rex.learn_trick("roll over")
rex.learn_trick("shake")
rex.show_off()

say("Dog name:", rex.name)
say("Dog sound:", rex.sound)

say("=== Blueprints complete ===")
