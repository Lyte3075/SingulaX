// 03_blueprints.sglx
// TOPIC: Blueprints, objects, initialization, methods, and inheritance.
// A blueprint is SingulaX's class-like object definition. //

say("=== SingulaX Blueprints ===")

// Animal is the base blueprint.
// init() runs when a new Animal is created. //
blueprint Animal
  function init(self, name, sound)
    self.name = name
    self.sound = sound
  end

  function speak(self)
    return self.name + " says " + self.sound
  end
end

// Dog inherits Animal.
// It keeps the basic animal data and adds dog-specific behavior. //
blueprint Dog is Animal
  function init(self, name)
    self.name = name
    self.sound = "Woof"
    self.tricks = []
  end

  function learn_trick(self, trick)
    self.tricks.push(trick)
  end

  function show_off(self)
    say(self.speak())
    say(self.name, "knows:", self.tricks)
  end
end

// Create an object from the base blueprint. //
let animal = new Animal("Creature", "...")

say(animal.speak())

// Create an object from the child blueprint. //
let rex = new Dog("Rex")

rex.learn_trick("sit")
rex.learn_trick("roll over")
rex.learn_trick("shake")

rex.show_off()

say("Dog name:", rex.name)
say("Dog sound:", rex.sound)

say("=== Blueprints complete ===")
