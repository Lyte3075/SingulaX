// 01_basics.sglx
// TOPIC: Variables, values, operators, strings, lists, and dictionaries.
// This script is intentionally self-contained. Run it from SingulaX Studio. //

say("=== SingulaX Basics ===")

// Variables store values. SingulaX can infer the value's type for you. //
let name = "Ada"
let age = 30
let learning = true
let nothing_here = nothing

say("Name:", name)
say("Age:", age)
say("Learning:", learning)
say("Nothing:", nothing_here)

// Math operators work directly on numbers. //
let a = 17
let b = 5

say("a + b =", a + b)
say("a - b =", a - b)
say("a * b =", a * b)
say("a / b =", a / b)
say("a // b =", a // b)
say("a % b =", a % b)
say("a ^ 2 =", a ^ 2)

// Strings can be joined with + or use {name} interpolation. //
say("Hello, " + name + "!")
say("Hello, {name}! You are {age}.")

// Conditions choose which code runs. //
let score = 82

if score >= 90 then
  say("Grade: A")
otherwise if score >= 80 then
  say("Grade: B")
otherwise if score >= 70 then
  say("Grade: C")
otherwise
  say("Grade: F")
end

// Lists hold ordered values and can be changed. //
let colors = ["red", "green", "blue"]
colors.push("purple")

say("Colors:", colors)
say("Color count:", len(colors))

for each color in colors do
  say("Color:", color)
end

// Dictionaries store named values. //
let person = {
  name: "Ada",
  age: 30,
  job: "Engineer"
}

say("Person name:", person.name)
say("Person job:", person.job)

person.city = "Baltimore"

for each key, value in person do
  say(key, "->", value)
end

say("=== Basics complete ===")
