// 01_basics.sglx //
// TOPIC: Variables, values, operators, strings, lists, and dictionaries. //
// Read this file from top to bottom as the first SingulaX lesson. //
// Every non-code explanation is written as a complete // comment // so the file can be copied directly. //

say("=== SingulaX Basics ===")

// A variable gives a value a name. SingulaX uses let for a normal variable. //
let name = "Ada"
let age = 30
let learning = true
let nothing_here = nothing

say("Name:", name)
say("Age:", age)
say("Learning:", learning)
say("Nothing:", nothing_here)

// Numbers support normal arithmetic operators. //
let a = 17
let b = 5
say("Addition:", a + b)
say("Subtraction:", a - b)
say("Multiplication:", a * b)
say("Division:", a / b)
say("Floor division:", a // b)
say("Remainder:", a % b)
say("Power:", a ^ 2)

// Strings can be combined with + or with {name} interpolation. //
say("Hello, " + name + "!")
say("Hello, {name}! You are {age} years old.")

// Comparisons produce true or false and can control an if statement. //
let score = 82
if score >= 90 then
  say("Grade: A")
elseif score >= 80 then
  say("Grade: B")
elseif score >= 70 then
  say("Grade: C")
else
  say("Grade: F")
end

// Lists keep values in order. push adds an item and pop removes an item. //
let colors = ["red", "green", "blue"]
colors.push("purple")
say("Colors:", colors)
say("First color:", colors[0])
say("List length:", len(colors))
let removed_color = colors.pop()
say("Removed color:", removed_color)

// for each is the readable way to visit every item in a list. //
for each color in colors do
  say("Color:", color)
end

// Dictionaries store named values. //
let person = {
  name: "Ada",
  age: 30,
  job: "Engineer"
}

say("Person name:", person.name)
say("Person job:", person.job)

person.city = "Baltimore"
say("Person city:", person.city)

// Dictionaries can also be iterated as key/value pairs. //
for each key, value in person do
  say(key, "->", value)
end

say("=== Basics complete ===")
