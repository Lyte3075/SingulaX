// 02_functions.sglx //
// TOPIC: Functions, parameters, defaults, return values, recursion, and closures. //
// This file is a complete lesson on reusable behavior. //

say("=== SingulaX Functions ===")

// A function groups logic under a reusable name. //
function add(a, b)
  return a + b
end

say("add(7, 5):", add(7, 5))

// Parameters can have default values. //
function greet(name = "friend")
  return "Hello, " + name + "!"
end

say(greet())
say(greet("SingulaX"))

// Functions can call other functions. //
function rectangle_area(width, height)
  return width * height
end

function rectangle_report(width, height)
  let area = rectangle_area(width, height)
  return "Area of " + width + "x" + height + " = " + area
end

say(rectangle_report(8, 4))

// Recursion means a function calls itself. The base case stops it. //
function factorial(n)
  if n <= 1 then
    return 1
  end
  return n * factorial(n - 1)
end

say("5!:", factorial(5))

// Functions can be stored in variables and called through the variable. //
function double(value)
  return value * 2
end

let operation = double
say("operation(21):", operation(21))

// A closure keeps access to variables created by its parent function. //
function make_counter()
  let count = 0
  function increment()
    count = count + 1
    return count
  end
  return increment
end

let counter = make_counter()
say("Counter:", counter())
say("Counter:", counter())
say("Counter:", counter())

// Anonymous functions can be assigned directly to a variable. //
let square = function(value)
  return value * value
end

say("square(9):", square(9))

say("=== Functions complete ===")
