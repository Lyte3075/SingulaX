// 12_data_and_lists.sglx //
// TOPIC: Lists, dictionaries, list methods, and practical data processing. //
// Use this file as a reference when working with collections. //

let inventory = ["apple", "banana", "orange"]
inventory.push("pear")
say("Inventory:", inventory)
say("First:", inventory[0])
say("Count:", len(inventory))

// Common list operations. //
inventory.insert(1, "grape")
say("After insert:", inventory)
say("Contains banana:", inventory.contains("banana"))
say("Index of orange:", inventory.index_of("orange"))
inventory.remove("banana")
say("After remove:", inventory)
inventory.reverse()
say("Reversed:", inventory)
inventory.sort()
say("Sorted:", inventory)

// Dictionaries group related named data. //
let player = {
  name: "Nova",
  score: 1250,
  level: 7
}
player.score += 250
say("Player:", player)
say("Score:", player.score)

// Data can be transformed with map, filter, and reduce. //
let scores = [10, 20, 35, 40, 55]
let boosted = scores.map(function(score)
  return score + 5
end)
let passing = scores.filter(function(score)
  return score >= 35
end)
let total = scores.reduce(function(a, b)
  return a + b
end, 0)

say("Boosted:", boosted)
say("Passing:", passing)
say("Total:", total)
