// 14_text_and_strings.sglx //
// TOPIC: Strings, interpolation, searching, and clean text processing. //

let first = "Ada"
let last = "Lovelace"
let full = first + " " + last

say("Full name:", full)
say("Interpolated:", "Hello, {first}!")

// String methods make text easier to process. //
let raw = "   SingulaX Programming   "
let clean = raw.trim()
say("Trimmed:", clean)
say("Lowercase:", clean.lower())
say("Uppercase:", clean.upper())
say("Length:", len(clean))

// split turns one string into a list. //
let words = "write code learn build".split(" ")
say("Words:", words)

// replace creates a changed copy of text. //
let message = "SingulaX is fun"
say("Changed:", message.replace("fun", "powerful"))

// Strings work naturally in conditions. //
if clean.contains("SingulaX") then
  say("The text contains SingulaX.")
end
