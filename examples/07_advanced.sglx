// 07_advanced.sglx
// TOPIC: Advanced data processing with comprehensions, higher-order functions,
// destructuring, variadic arguments, pattern matching, assertions, and JSON. //
// Each section produces a real result so the file is a runnable lesson. //

say("=== SingulaX Advanced Features ===")

// List comprehensions create new lists from existing data. //
let numbers = range(1, 11)

let squares = [
  x * x
  for each x in numbers
]

let evens = [
  x
  for each x in numbers
  where x % 2 == 0
]

say("Numbers:", numbers)
say("Squares:", squares)
say("Evens:", evens)

// map transforms every item. //
let doubled = numbers.map(function(x)
  return x * 2
end)

say("Doubled:", doubled)

// filter keeps only items that pass a condition. //
let large = numbers.filter(function(x)
  return x > 7
end)

say("Numbers over 7:", large)

// reduce combines many values into one result. //
let total = numbers.reduce(function(accumulator, value)
  return accumulator + value
end, 0)

say("Sum:", total)

// Destructuring can unpack multiple values. //
let first, second = 10, 20
say("Before swap:", first, second)

first, second = second, first

say("After swap:", first, second)

// A function can return a list that can be unpacked. //
function min_and_max(values)
  return [min(values), max(values)]
end

let lowest, highest = min_and_max(numbers)

say("Lowest:", lowest)
say("Highest:", highest)

// Variadic parameters collect any number of arguments into one list. //
function total_of(...values)
  return values.reduce(function(accumulator, value)
    return accumulator + value
  end, 0)
end

say("total_of:", total_of(1, 2, 3, 4))

// Pattern matching selects behavior from a value. //
function describe_day(day)
  match day
    when "Saturday" then
      return "Weekend"
    when "Sunday" then
      return "Weekend"
    otherwise
      return "Weekday"
  end
end

say("Saturday:", describe_day("Saturday"))
say("Tuesday:", describe_day("Tuesday"))

// Assertions are useful for checking assumptions while developing. //
assert(total_of(1, 2, 3) == 6, "total_of failed")

// JSON converts structured SingulaX data into text and back. //
let profile = {
  name: "Ada",
  skills: ["math", "engineering"],
  active: true
}

let json_text = to_json(profile)
say("JSON:", json_text)

let restored = from_json(json_text)

say("Restored name:", restored.name)
say("Restored skills:", restored.skills)

say("=== Advanced features complete ===")
