// 15_keyboard_and_mouse.sglx //
// TOPIC: Desktop keyboard and mouse input. //
// Run this in the Preview window. //

let x = 380
let y = 210
let speed = 5

forever do
  clear_screen()

  if key_down("ArrowLeft") then
    x -= speed
  end
  if key_down("ArrowRight") then
    x += speed
  end
  if key_down("ArrowUp") then
    y -= speed
  end
  if key_down("ArrowDown") then
    y += speed
  end

  // WASD uses the same key_down API with key names. //
  if key_down("a") then x -= speed end
  if key_down("d") then x += speed end
  if key_down("w") then y -= speed end
  if key_down("s") then y += speed end

  draw_rect(x, y, 50, 50, "cyan")

  if mouse_down("left") then
    draw_circle(mouse_x(), mouse_y(), 10, "red")
  end

  draw_text("Arrow keys / WASD = move", 20, 30, 18, "white")
  draw_text("Hold left mouse = draw marker", 20, 58, 18, "white")
end
