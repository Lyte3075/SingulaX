// 05_modules.sglx //
// TOPIC: Modules and reusable code across files. //
// This lesson is intentionally a two-file example because modules are about file boundaries. //
// Keep this script beside geometry.sglx, then run this script. //

say("=== SingulaX Modules ===")

// use loads another SingulaX source file into this script. //
// as gives the imported module a local name. //
use "geometry.sglx" as geometry

// Public values from the module are accessed through its name. //
say("Pi:", geometry.pi)

let radius = 3
let width = 8
let height = 4

say("Circle area:", geometry.circle_area(radius))
say("Rectangle area:", geometry.rectangle_area(width, height))
say("Rectangle perimeter:", geometry.rectangle_perimeter(width, height))

// The important rule is that the reusable calculations live in geometry.sglx. //
// The main script owns the application logic that uses those calculations. //

say("=== Modules complete ===")
