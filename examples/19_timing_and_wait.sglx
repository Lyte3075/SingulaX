// 19_timing_and_wait.sglx //
// TOPIC: Delays, frame loops, and waiting for a condition. //

say("Starting timer lesson.")

// wait pauses the current script for a number of seconds. //
say("Wait 1 second...")
wait(1)
say("Done.")

// wait can be used inside a repeated task. //
repeat(3)
  say("Tick")
  wait(0.25)
end

// wait.until waits until a condition becomes true. //
let ready = false

function become_ready()
  wait(0.5)
  ready = true
end

become_ready()
wait.until(ready)
say("The condition is ready.")
