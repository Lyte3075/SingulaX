// 16_touch_controls.sglx //
// TOPIC: Touch input and the mobile control surface. //
// Run this on a phone or tablet in the Studio Preview. //

let x = 380
let y = 210
let speed = 4

forever do
  clear_screen()

  // touching tells you whether the screen currently has a touch. //
  if touching() then
    x = touch_x()
    y = touch_y()
  end

  draw_circle(x, y, 28, "deepskyblue")
  draw_text("Touch the preview to move the marker.", 20, 30, 18, "white")
  draw_text("The mobile control surface also exposes gamepad-style inputs.", 20, 58, 16, "white")
end
