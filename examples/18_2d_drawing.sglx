// 18_2d_drawing.sglx //
// TOPIC: The 2D drawing API. //
// This script puts the main drawing primitives in one place. //

clear_screen()

// Rectangles use x, y, width, height, and a color. //
draw_rect(40, 60, 160, 90, "royalblue")

// Circles use a center, radius, and color. //
draw_circle(300, 105, 45, "magenta")

// Lines use two endpoints and a color. //
draw_line(400, 60, 650, 150, "cyan")

// Text uses content, x, y, size, and color. //
draw_text("SingulaX 2D Drawing", 40, 210, 28, "white")
draw_text("Rectangle", 60, 95, 16, "white")
draw_text("Circle", 275, 100, 16, "white")
draw_text("Line", 500, 100, 16, "white")
