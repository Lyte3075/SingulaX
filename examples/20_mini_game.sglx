// 20_mini_game.sglx //
// TOPIC: Combining variables, input, collision, drawing, and a game loop. //
// This is a complete tiny game example that shows how the pieces fit together. //

let player_x = 360
let player_y = 380
let player_speed = 5
let coin_x = 200
let coin_y = 180
let score = 0

forever do
  clear_screen()

  // Read keyboard input and move the player. //
  if key_down("ArrowLeft") then
    player_x -= player_speed
  end
  if key_down("ArrowRight") then
    player_x += player_speed
  end
  if key_down("ArrowUp") then
    player_y -= player_speed
  end
  if key_down("ArrowDown") then
    player_y += player_speed
  end

  // Keep the player inside the preview area. //
  player_x = clamp(player_x, 20, 730)
  player_y = clamp(player_y, 20, 400)

  // Move the coin slowly toward a new position after collection. //
  let dx = player_x - coin_x
  let dy = player_y - coin_y
  let distance = sqrt(dx * dx + dy * dy)

  if distance < 45 then
    score += 1
    coin_x = random_int(40, 760)
    coin_y = random_int(80, 380)
  end

  // Draw the game world. //
  draw_rect(0, 0, 800, 450, "#08111f")
  draw_circle(coin_x, coin_y, 18, "gold")
  draw_rect(player_x, player_y, 50, 50, "cyan")

  draw_text("MINI GAME", 20, 30, 22, "white")
  draw_text("Collect the gold circle.", 20, 58, 16, "white")
  draw_text("Score: {score}", 20, 84, 16, "white")
end
