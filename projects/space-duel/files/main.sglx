local p1x = 180
local p2x = 620
local shotX = -100
local shotY = 0
local score = 0

forever do
  clear_screen()
  draw_text("SPACE DUEL", 24, 34, 28, "white")
  draw_text("Left joystick = move   A = fire", 24, 64, 16, "white")
  draw_text("Score: " .. score, 24, 92, 18, "cyan")

  local moveX = gamepad_axis(0, 0)

  if abs(moveX) > 0.15 then
    p1x += moveX * 5
  end

  if gamepad_button(0, 0) then
    shotX = p1x
    shotY = 330
    wait(0.15)
  end

  if shotY > 0 then
    shotY -= 7
    draw_circle(shotX, shotY, 6, "yellow")
    if shotY < 80 and abs(shotX - p2x) < 40 then
      score += 1
      shotY = -1
    end
  end

  draw_rect(p1x - 30, 360, 60, 30, "cyan")
  draw_rect(p2x - 30, 60, 60, 30, "red")
  wait(0.016)
end